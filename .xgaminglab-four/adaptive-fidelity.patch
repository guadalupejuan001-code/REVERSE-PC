+// C04: multi-layer damage tracker. Unlike TileCache it does not assume one
+// VisualTile per 12px cell: quality mode may preserve several independent
+// splats at different depths/colors. Their ORDER is part of the cell state.
+class LayeredTileCache {
+  using Key=std::pair<int,int>;
+  using Bucket=std::vector<visual::VisualTile>;
+  std::map<Key,Bucket> old_,next_;
+  bool valid_=false,pending_=false;
+  int width_=0,height_=0,effect_h_=0,tile_px_=12;
+  int pending_w_=0,pending_h_=0,pending_effect_h_=0,pending_tile_px_=12;
+  std::uint64_t base_key_=0,next_key_=0;
+ public:
+  void reset(){old_.clear();next_.clear();valid_=pending_=false;}
+  Change plan(const std::vector<visual::VisualTile>&tiles,int w,int h,int effect_h,int tile_px,
+              std::uint64_t base_key,bool retained_valid){
+    pending_=true;next_.clear();pending_w_=w;pending_h_=h;pending_effect_h_=effect_h;
+    pending_tile_px_=std::max(1,tile_px);next_key_=base_key;
+    Change full_draw{true,full(w,h)};
+    if(w<1||h<1||effect_h<1)return full_draw;
+    for(const auto&t:tiles){
+      if(!std::isfinite(t.ndc_x)||!std::isfinite(t.ndc_y)||!std::isfinite(t.depth)||
+         !std::isfinite(t.size_px)||t.size_px<=0){reset();return full_draw;}
+      const int cx=int(std::floor((double(t.ndc_x)*.5+.5)*w/pending_tile_px_));
+      const int cy=int(std::floor((double(t.ndc_y)*.5+.5)*h/pending_tile_px_));
+      next_[{cx,cy}].push_back(t);
+    }
+    if(!valid_||!retained_valid||width_!=w||height_!=h||effect_h_!=effect_h||
+       tile_px_!=pending_tile_px_||base_key_!=base_key)return full_draw;
+    Change result{false,{}};
+    for(const auto& [key,bucket]:old_){
+      const auto it=next_.find(key);
+      if(it==next_.end()||it->second!=bucket){
+        for(const auto&t:bucket)result.rect=join(result.rect,coverage(t,w,h,effect_h));
+        if(it!=next_.end())for(const auto&t:it->second)result.rect=join(result.rect,coverage(t,w,h,effect_h));
+        result.changed_cells+=bucket.size();
+      }else result.unchanged_cells+=bucket.size();
+    }
+    for(const auto& [key,bucket]:next_)if(old_.find(key)==old_.end()){
+      for(const auto&t:bucket)result.rect=join(result.rect,coverage(t,w,h,effect_h));
+      result.changed_cells+=bucket.size();
+    }
+    if(result.rect.area()*5>=std::uint64_t(w)*h*3)return full_draw;
+    return result;
+  }
+  void commit(){
+    if(!pending_)return;
+    old_.swap(next_);next_.clear();width_=pending_w_;height_=pending_h_;
+    effect_h_=pending_effect_h_;tile_px_=pending_tile_px_;base_key_=next_key_;
+    valid_=true;pending_=false;
+  }
+};
