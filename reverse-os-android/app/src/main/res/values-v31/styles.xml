<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Android 12+ always shows a platform splash before our BootActivity.
       Force it black with no white application icon, so every visible
       frame belongs to the requested black REVERSE OS boot experience. -->
  <style name="Theme.ReverseOS" parent="android:style/Theme.Material.NoActionBar">
    <item name="android:fontFamily">sans</item>
    <item name="android:windowBackground">#000000</item>
    <item name="android:colorAccent">#42e8cc</item>
    <item name="android:statusBarColor">#000000</item>
    <item name="android:navigationBarColor">#000000</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
    <item name="android:windowSplashScreenBackground">#000000</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_blank</item>
    <item name="android:windowSplashScreenIconBackgroundColor">#000000</item>
  </style>
</resources>
